# ─── Required ────────────────────────────────────────────────────────────
# The two keys the terminal cannot run without.

# Superior Trade API key — executes backtests and runs live strategies.
# Create one at https://superior.trade (Account → API keys).
SUPERIOR_TRADE_API_KEY=

# OpenRouter key — powers the chat agent and setup detection.
# Create one at https://openrouter.ai/keys
OPENROUTER_API_KEY=


# ─── Optional: models ────────────────────────────────────────────────────
# Sensible defaults are compiled in; override to trade cost against quality.
AGENT_MODEL=
DETECT_MODEL=
COMPACT_MODEL=
# Retried automatically when AGENT_MODEL errors or rate-limits.
FALLBACK_MODEL=
# Context budget the chat compactor works to, in tokens. Lower it for a
# cheaper/smaller model, raise it for a larger one. Default suits ~200k models.
NEXT_PUBLIC_CONTEXT_WINDOW_TOKENS=


# ─── Optional: database ──────────────────────────────────────────────────
# Unset (the default) runs an embedded Postgres and stores it in ./.data/pglite
# — no server to install, no account to create. Point this at any Postgres URL
# to use one instead; a *.neon.tech host automatically uses Neon's HTTP driver.
DATABASE_URL=
# Where the embedded database keeps its files.
PGLITE_PATH=
# Direct (unpooled) connection, used for migrations only. Neon exposes both a
# pooled and an unpooled URL and prefers the unpooled one for DDL; either name
# works. Ignored entirely by the embedded database.
DATABASE_URL_UNPOOLED=
POSTGRES_URL_NON_POOLING=
# Apply migrations on boot even for a DATABASE_URL you supplied ("1" to opt in).
# The embedded database always migrates itself.
DB_AUTO_MIGRATE=


# ─── Optional: everything else ───────────────────────────────────────────
# Superior Trade API base. This is a hosted service — it is not part of this
# repository and there is nothing to run locally. Leave it alone unless you have
# been given a different environment to point at.
SUPERIOR_TRADE_API_URL=https://api.superior.trade

# "mainnet" | "testnet"
NEXT_PUBLIC_HL_NETWORK=mainnet
# Venue-level Hyperliquid builder fee shown in the pair picker ("0.04" or "0.04%").
NEXT_PUBLIC_HL_BUILDER_FEE=0.04
# Multi-venue (Lighter) UI. Off by default; the UI is byte-identical when off.
NEXT_PUBLIC_FEATURE_LIGHTER_EXCHANGE=false

# Public origin, used for canonical URLs, sitemap and share images.
NEXT_PUBLIC_SITE_URL=

# Shared secret for /api/cron/one-shot-sweep. Unset leaves the route open.
CRON_SECRET=

# Where `npm run setup:charts` clones TradingView Advanced Charts from. Only
# needed if TradingView moves the repository — see docs/charting-library.md.
CHARTING_LIBRARY_REPO=

# HyperTracker key for liquidation heatmaps on coins the built-in collector
# does not cover. Unset simply hides the heatmap for those coins.
COINMARKETMAN_API_KEY=

# Emergency stops for money movement. Set any to "1" to reject that category
# with a 503 until cleared. FREEZE_ALL trips every one at once.
FREEZE_ALL=
FREEZE_DEPOSITS=
FREEZE_WITHDRAWALS=
FREEZE_TRADING=

# Coins the order-flow recorder tracks, comma-separated. Unset = a default set.
COLLECTOR_COINS=

# Product analytics (PostHog). Unset = nothing is sent anywhere.
POSTHOG_KEY=
POSTHOG_HOST=

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Unset = GA disabled.
NEXT_PUBLIC_GA_ID=

# Error monitoring (Sentry). Unset = disabled, and no source maps are uploaded.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_REPLAY_SESSION_SAMPLE_RATE=0
NEXT_PUBLIC_SENTRY_REPLAY_ERROR_SAMPLE_RATE=1.0
