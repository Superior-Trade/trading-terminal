{
  "name": "trading-terminal",
  "version": "0.1.0",
  "private": false,
  "license": "Apache-2.0",
  "description": "Literally draw where you think the market is going. Get a fully managed trade back — an AI trading terminal for Hyperliquid.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Superior-Trade/trading-terminal.git"
  },
  "homepage": "https://github.com/Superior-Trade/trading-terminal#readme",
  "bugs": "https://github.com/Superior-Trade/trading-terminal/issues",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "predev": "node scripts/check-charting-library.mjs",
    "dev": "next dev --webpack -p 3200",
    "dev:turbo": "next dev --turbopack -p 3200",
    "prebuild": "node scripts/check-charting-library.mjs",
    "build": "next build --webpack",
    "start": "next start -p 3200",
    "setup:charts": "node scripts/setup-charting-library.mjs",
    "test": "vitest run",
    "lint": "eslint",
    "check-types": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "test:e2e": "node evals/e2e.mjs",
    "preview": "node scripts/preview-readme.mjs",
    "screenshot": "node scripts/screenshot.mjs",
    "record": "node scripts/record.mjs"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.16",
    "@electric-sql/pglite": "^0.3.11",
    "@neondatabase/serverless": "^0.10.4",
    "@nktkas/hyperliquid": "^0.32.1",
    "@openrouter/ai-sdk-provider": "^2.10.0",
    "@sentry/nextjs": "^10.52.0",
    "ai": "^6.0.219",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.23.0",
    "lightweight-charts": "^5.2.1",
    "next": "16.2.12",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "streamdown": "^2.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "playwright": "^1.62.1",
    "tailwindcss": "^4",
    "typescript": "^5.9",
    "vitest": "^3.2.6"
  }
}
